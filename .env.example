DATABASE_URL=file:./data/exam-platform.db
STORAGE_DRIVER=sqlite
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-initial-password
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_MINUTE=120
SHARE_LOOKUP_RATE_LIMIT_PER_MINUTE=60
SYNC_RATE_LIMIT_PER_MINUTE=30
CREATE_EXAM_RATE_LIMIT_PER_MINUTE=10
SHARE_CREATE_RATE_LIMIT_PER_MINUTE=10
OFFICIAL_DOWNLOAD_RATE_LIMIT_PER_MINUTE=30
DISCORD_SECURITY_WEBHOOK_URL=
GEMINI_API_KEY=
GEMINI_API_KEYS=
IMGBB_API_KEY=
IMGBB_UPLOAD_RATE_LIMIT_PER_MINUTE=10
ADMIN_RATE_LIMIT_PER_MINUTE=120

# AI pool: use GEMINI_API_KEYS (comma/newline separated) OR numbered keys.
# Each key has its own atomic internal RPM window; when one is full/cooling down,
# the server automatically fails over to the next available key.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_RPM_LIMIT=15
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# GEMINI_API_KEYS=key1,key2,key3,key4,key5
SHARE_UPDATE_RATE_LIMIT_PER_MINUTE=20
SHARE_DELETE_RATE_LIMIT_PER_MINUTE=20
DELETE_EXAM_RATE_LIMIT_PER_MINUTE=20
